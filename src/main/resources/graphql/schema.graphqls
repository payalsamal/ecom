type Query {
    getProducts: [ProductDto]
}

type ProductDto {
    id: ID
    name: String
    price: Float
}

type Mutation{
	saveUser(user: ApplicationUserInput): ApplicationUserDto
}
type ApplicationUserDto {
    id: ID
    email: String
    userType: String
    active: Boolean
    userName: String
}

input ApplicationUserInput {
    email: String
    password: String
    userType: String
    userName: String
}